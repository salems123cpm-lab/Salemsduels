ENTRY_DELAY = 0.01,
COOLDOWN = 0.05,
STEAL_RANGE = 6,
PRIME_RANGE = math.clamp(tonumber(autoStealValues.Radius) or 65, 10, 150),
}
local stealPromptCache = setmetatable({}, { __mode = "k" })
local function getCachedStealPrompt(spawn)
