-- Reaplica la paleta generada sobre todos los controles modernos.
-- Esto evita que el palette legacy (marron) vuelva a sobrescribir GUI 1.
local function applyModernGeneratedPalette()
local colors = _G.__CrystalThemeColors or {}
local base = colors.base or C.bg
local top = colors.top or C.bgDark
local accent = colors.accent or C.accent
local dark = base:Lerp(Color3.new(0, 0, 0), 0.38)
local row = base:Lerp(top, 0.22)
local accentDim = accent:Lerp(base, 0.58)
local divider = accent:Lerp(base, 0.72)

for _, obj in ipairs(inner:GetDescendants()) do
if obj:IsA("UIStroke") then
local parent = obj.Parent
if parent and (parent.Name == "SectionHeading" or parent.Name == "BackgroundThemeButton") then
obj.Color = accent:Lerp(base, 0.28)
elseif parent and parent.Name == "Indicator" then
obj.Color = accent
elseif obj.Name ~= "UnifiedPanelWhiteOutline" and obj.Name ~= "UnifiedPanelWhiteGlow" then
-- Solo reemplaza strokes que pertenecían a la paleta fija antigua.
local c = obj.Color
if c == C.divider or c == C.accentDim or c == C.accent then
obj.Color = divider
end
end
elseif obj:IsA("Frame") or obj:IsA("TextButton") or obj:IsA("TextBox") or obj:IsA("TextLabel") then
local c = obj.BackgroundColor3
if c == C.bg then
obj.BackgroundColor3 = base
elseif c == C.bgDark then
obj.BackgroundColor3 = dark
elseif c == C.row then
obj.BackgroundColor3 = row
elseif c == C.accent then
obj.BackgroundColor3 = accent
elseif c == C.accentDim then
obj.BackgroundColor3 = accentDim
elseif c == C.divider then
obj.BackgroundColor3 = divider
end

-- Los encabezados de sección siempre siguen el accent del BG.
if obj.Name == "SectionHeading" then
obj.BackgroundColor3 = base:Lerp(top, 0.12)
elseif obj.Name == "SectionRail" then
obj.BackgroundColor3 = accent
elseif obj.Name == "SectionLine" then
obj.BackgroundColor3 = accent:Lerp(base, 0.25)
end
end
end

-- Textos que originalmente usaban el accent fijo.
for _, obj in ipairs(inner:GetDescendants()) do
if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
if obj.TextColor3 == C.accent or obj.Parent and obj.Parent.Name == "SectionHeading" then
obj.TextColor3 = accent
elseif obj.Name == "BackgroundThemeButton" then
obj.TextColor3 = accent
end
end
end
end
