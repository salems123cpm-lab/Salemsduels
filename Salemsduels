local function loadSkinAsset(assetId)
assetId = tonumber(assetId)
if not assetId then return nil end
local ok, objects = pcall(function() return game:GetObjects("rbxassetid://"..tostring(assetId)) end)
if ok and type(objects) == "table" and #objects > 0 then return objects end
local InsertService = game:GetService("InsertService")
ok, objects = pcall(function() return InsertService:LoadAsset(assetId) end)
if ok and objects then return {objects} end
return nil
end

local function setClassicClothing(character, skin)
for _,o in ipairs(character:GetChildren()) do
if (o:IsA("Shirt") or o:IsA("Pants")) and o:GetAttribute("GlazierSkinClothing") then
pcall(function() o:Destroy() end)
end
end
if skin.shirt then
local sh=Instance.new("Shirt")
sh.Name="GlazierSkinShirt"; sh:SetAttribute("GlazierSkinClothing",true)
sh.ShirtTemplate=skin.shirt; sh.Parent=character; table.insert(localSkinObjects,sh)
end
if skin.pants then
