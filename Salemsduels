if categoryList then
for _, obj in ipairs(categoryList:GetChildren()) do
if obj:IsA("TextButton") then
obj.TextColor3 = white
local mark = obj:FindFirstChild("Indicator")
if mark then
mark.BackgroundColor3 = accent
end
