-- ==================== FULL GENERATED THEME PASS ====================
-- La interfaz tiene varias capas históricas y algunos controles se crean
-- fuera de inner (quick buttons / paneles). Esta pasada pinta TODOS los
-- elementos de nuestras GUIs usando únicamente la paleta del BG activo.
-- No depende de que el color original sea exactamente igual a C.*.
_G.__CrystalApplyFullGeneratedTheme = function()
local theme = _G.__CrystalThemeColors or {}
local base = theme.base or Color3.fromRGB(5, 17, 39)
local top = theme.top or Color3.fromRGB(220, 238, 255)
local accent = theme.accent or Color3.fromRGB(92, 181, 255)
local dark = base:Lerp(Color3.new(0, 0, 0), 0.42)
local panel = base:Lerp(top, 0.18)
local row = base:Lerp(top, 0.32)
local dimAccent = accent:Lerp(base, 0.55)
local softAccent = accent:Lerp(base, 0.72)
local white = Color3.new(1, 1, 1)

local function metrics(c)
local mx = math.max(c.R, c.G, c.B)
local mn = math.min(c.R, c.G, c.B)
local lum = (c.R * 0.299) + (c.G * 0.587) + (c.B * 0.114)
local sat = mx > 0 and ((mx - mn) / mx) or 0
return lum, sat
end

local function isWhite(c)
return c.R > 0.88 and c.G > 0.88 and c.B > 0.88
end

local function isBlack(c)
return c.R < 0.08 and c.G < 0.08 and c.B < 0.08
end

local function semanticBackground(obj)
local n = string.lower(obj.Name or "")
local old = obj.BackgroundColor3
local lum, sat = metrics(old)

if n:find("knob") or n:find("thumb") or n:find("handle") then
return white
end
if n:find("sectionheading") then
return base:Lerp(top, 0.12)
end
if n:find("sectionrail") or n:find("sectionline") or n:find("indicator") then
return accent
end
if n:find("header") or n:find("topbar") then
return top
end
if n:find("backgroundthemebutton") or n:find("themebutton") then
return base:Lerp(top, 0.18)
end
if n:find("quick") or n:find("aimbotbutton") or n:find("batbutton")
or n:find("tpdownbutton") or n:find("dropbutton")
or n:find("carryspeedbutton") or n:find("speedbutton")
or n:find("autoplaybutton") or n:find("customspeedbutton") then
if sat > 0.12 or lum > 0.55 then
return accent
end
return dark
end
if obj:IsA("TextButton") then
-- Botón seleccionado/activo: accent. Botón normal: row.
if obj:GetAttribute("Selected") == true or obj:GetAttribute("Active") == true then
return dimAccent
end
if sat > 0.12 and lum > 0.16 then
return dimAccent
end
return row
end
if obj:IsA("ScrollingFrame") then
return dark
end
if isWhite(old) and lum > 0.9 then
-- Evita que botones/filas blancas de la UI antigua sobrevivan.
return row
end
if sat > 0.10 and lum > 0.13 then
return softAccent
end
if lum < 0.18 then
return panel
end
return row
end

local function paintRoot(root)
if not root or not root.Parent then return end

if root:IsA("GuiObject") and root.Name ~= "CrystalQuickButtons" then
root.BackgroundColor3 = base
end

for _, obj in ipairs(root:GetDescendants()) do
local n = string.lower(obj.Name or "")

if obj:IsA("UIStroke") then
if n:find("unifiedpanelwhite") or n:find("whiteoutline") or n:find("whiteglow") then
-- El marco exterior también pertenece al color del BG.
obj.Color = accent:Lerp(white, 0.25)
elseif n:find("section") or n:find("indicator") or n:find("theme") then
obj.Color = accent:Lerp(base, 0.25)
else
obj.Color = accent:Lerp(base, 0.55)
end

elseif obj:IsA("UIGradient") then
-- Solo recolorea gradientes de controles; no toca el gradiente
-- principal del background, que ya usa themeGradient.
local parent = obj.Parent
if parent and parent ~= themeCanvas and parent ~= background then
local pn = string.lower(parent.Name or "")
if not pn:find("blackout") then
obj.Color = ColorSequence.new({
ColorSequenceKeypoint.new(0, top),
ColorSequenceKeypoint.new(0.5, accent:Lerp(base, 0.35)),
ColorSequenceKeypoint.new(1, base),
})
end
end

elseif obj:IsA("Frame") or obj:IsA("TextButton") or obj:IsA("TextBox")
or obj:IsA("ScrollingFrame") or obj:IsA("ViewportFrame") then

if obj.BackgroundTransparency < 1 then
-- No pintar overlays puramente decorativos de negro.
if not n:find("blackout") and not n:find("background") then
obj.BackgroundColor3 = semanticBackground(obj)
end
end

if n:find("sectionrail") or n:find("sectionline") or n:find("indicator") then
obj.BackgroundColor3 = accent
end

if n:find("sectionheading") then
obj.BackgroundColor3 = base:Lerp(top, 0.12)
end

elseif obj:IsA("TextLabel") then
if obj:GetAttribute("GlazierDuelsKeepBlackText") then
obj.TextColor3 = white
else
local lum, sat = metrics(obj.TextColor3)
if obj.Parent and string.lower(obj.Parent.Name or ""):find("sectionheading") then
obj.TextColor3 = accent
elseif sat > 0.10 and lum < 0.92 then
obj.TextColor3 = accent
elseif lum < 0.55 then
obj.TextColor3 = white:Lerp(accent, 0.35)
end
end

end

-- TextButton/TextBox need an independent text-color pass because they
-- are also handled by the background branch above. This prevents
-- numeric fields (Speed/FOV/etc.) from keeping a previous execution's color.
if obj:IsA("TextButton") or obj:IsA("TextBox") then
if obj:GetAttribute("GlazierDuelsKeepBlackText") then
obj.TextColor3 = white
else
local n2 = string.lower(obj.Name or "")
if obj:IsA("TextBox") or n2:find("speed") or n2:find("value")
or n2:find("number") or n2:find("amount") or n2:find("radius")
or n2:find("duration") or n2:find("fov") then
obj.TextColor3 = accent
else
obj.TextColor3 = white
end
end
end
end
end

-- Main GUI + floating quick buttons.
paintRoot(ScreenGui)
if _G.__CrystalQuickButtonsFrame then
paintRoot(_G.__CrystalQuickButtonsFrame)
end

-- Lagger / Bypass y cualquier otro panel Crystal ya creado.
local playerGui = Player:FindFirstChildOfClass("PlayerGui")
if playerGui then
for _, gui in ipairs(playerGui:GetChildren()) do
if gui:IsA("ScreenGui") then
local gn = string.lower(gui.Name or "")
if gn:find("crystal") or gn:find("glazier") then
paintRoot(gui)
end
end
end
end

