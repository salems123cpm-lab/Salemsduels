local SkyLighting = game:GetService("Lighting")
local SkyRunService = game:GetService("RunService")
local SkyTerrain = workspace:FindFirstChildOfClass("Terrain")
local savedSkyMode = tostring(_G.__CrystalSkyChangerMode or "")
local savedSkyIndex = tonumber(_G.__savedSkyIndex)
local initialSkyMode = SKY_PRESETS[savedSkyMode] and savedSkyMode or nil
if not initialSkyMode and savedSkyIndex and SKY_PRESETS_LIST[savedSkyIndex] then
initialSkyMode = SKY_PRESETS_LIST[savedSkyIndex]
end
initialSkyMode = initialSkyMode or "Off"
_G.__GlazierAmbSkyMode = initialSkyMode
for i,n in ipairs(SKY_PRESETS_LIST) do if n == initialSkyMode then _G.__GlazierAmbSkyIndex = i break end end

local skyConnections = {}
local skyOriginal = _G.__GlazierAmbSkyOriginal or {}
_G.__GlazierAmbSkyOriginal = skyOriginal
local skyDynToken = 0
local skyRainbowToken = 0

local function skyColor(t)
return Color3.fromRGB(tonumber(t[1]) or 0, tonumber(t[2]) or 0, tonumber(t[3]) or 0)
end

local function clearSkyConnections()
for _, c in ipairs(skyConnections) do pcall(function() c:Disconnect() end) end
table.clear(skyConnections)
end

local function clearCustomSky()
for _, obj in ipairs(SkyLighting:GetChildren()) do
if obj:GetAttribute("_GlazierAmbSky") then pcall(function() obj:Destroy() end) end
end
local terrain = workspace:FindFirstChildOfClass("Terrain")
if terrain then
for _, obj in ipairs(terrain:GetChildren()) do
if obj:GetAttribute("_GlazierAmbSky") then pcall(function() obj:Destroy() end) end
end
end
local flash = workspace:FindFirstChild("GlazierAmbSkyFlash")
if flash then pcall(function() flash:Destroy() end) end
end

local function captureOriginalSky()
if skyOriginal.captured then return end
skyOriginal.captured = true
skyOriginal.objects = {}
local function capture(obj, parent)
if not obj or obj:GetAttribute("_GlazierAmbSky") then return end
local data = {class=obj.ClassName, parent=parent, props={}}
if obj:IsA("Sky") then
data.props.StarCount = obj.StarCount
data.props.MoonAngularSize = obj.MoonAngularSize
data.props.SunAngularSize = obj.SunAngularSize
data.props.MoonTextureId = obj.MoonTextureId
elseif obj:IsA("Atmosphere") then
data.props.Density=obj.Density; data.props.Color=obj.Color; data.props.Decay=obj.Decay
data.props.Glare=obj.Glare; data.props.Haze=obj.Haze
elseif obj:IsA("Clouds") then
data.props.Cover=obj.Cover; data.props.Density=obj.Density; data.props.Color=obj.Color
end
table.insert(skyOriginal.objects, data)
end
for _, obj in ipairs(SkyLighting:GetChildren()) do
if obj:IsA("Sky") or obj:IsA("Atmosphere") then capture(obj, SkyLighting) end
end
local terrain = workspace:FindFirstChildOfClass("Terrain")
if terrain then
for _, obj in ipairs(terrain:GetChildren()) do
if obj:IsA("Clouds") then capture(obj, terrain) end
end
end
skyOriginal.lighting = {
Ambient=SkyLighting.Ambient, OutdoorAmbient=SkyLighting.OutdoorAmbient,
Brightness=SkyLighting.Brightness, ClockTime=SkyLighting.ClockTime,
FogStart=SkyLighting.FogStart, FogEnd=SkyLighting.FogEnd, FogColor=SkyLighting.FogColor,
GlobalShadows=SkyLighting.GlobalShadows, ExposureCompensation=SkyLighting.ExposureCompensation,
ColorShift_Top=SkyLighting.ColorShift_Top, ColorShift_Bottom=SkyLighting.ColorShift_Bottom,
GeographicLatitude=SkyLighting.GeographicLatitude,
EnvironmentDiffuseScale=SkyLighting.EnvironmentDiffuseScale,
EnvironmentSpecularScale=SkyLighting.EnvironmentSpecularScale,
}
end

local function restoreOriginalSky()
clearCustomSky()
for _, obj in ipairs(SkyLighting:GetChildren()) do
if obj:IsA("Sky") or obj:IsA("Atmosphere") then pcall(function() obj:Destroy() end) end
end
local terrain = workspace:FindFirstChildOfClass("Terrain")
if terrain then
for _, obj in ipairs(terrain:GetChildren()) do
if obj:IsA("Clouds") then pcall(function() obj:Destroy() end) end
end
end
if skyOriginal.objects then
for _, data in ipairs(skyOriginal.objects) do
if data.parent then
local obj=Instance.new(data.class)
for k,v in pairs(data.props) do pcall(function() obj[k]=v end) end
obj.Parent=data.parent
end
end
end
if skyOriginal.lighting then
for k,v in pairs(skyOriginal.lighting) do pcall(function() SkyLighting[k]=v end) end
end
end

local function applySkyObjects(preset)
clearCustomSky()
if preset.sky then
local sky=Instance.new("Sky")
sky.Name="GlazierAmbSky"; sky:SetAttribute("_GlazierAmbSky", true)
if preset.sky.stars then sky.StarCount=preset.sky.stars end
if preset.sky.moon then sky.MoonAngularSize=preset.sky.moon end
if preset.sky.sun then sky.SunAngularSize=preset.sky.sun end
if preset.sky.moonTex then sky.MoonTextureId="rbxasset://sky/moon.jpg" end
sky.Parent=SkyLighting
end
if not preset.noAtm then
local atm=Instance.new("Atmosphere")
atm.Name="GlazierAmbAtmosphere"; atm:SetAttribute("_GlazierAmbSky", true)
local a=preset.atm or {}
atm.Density=a.dens or 0.3; atm.Color=skyColor(a.color or {200,200,200})
atm.Decay=skyColor(a.decay or {200,200,200}); atm.Glare=a.glare or 0; atm.Haze=a.haze or 0
atm.Parent=SkyLighting
end
local terrain=workspace:FindFirstChildOfClass("Terrain")
if preset.clouds and terrain then
local cl=Instance.new("Clouds")
cl.Name="GlazierAmbClouds"; cl:SetAttribute("_GlazierAmbSky", true)
cl.Cover=preset.clouds.cover or 0.5; cl.Density=preset.clouds.dens or 0.5
cl.Color=skyColor(preset.clouds.color or {255,255,255}); cl.Parent=terrain
end
end

local function startSkyDynamics(preset)
skyDynToken += 1
skyRainbowToken += 1
local dyn=skyDynToken
local rainbow=skyRainbowToken
if preset.rainbow and preset.atm then
task.spawn(function()
while rainbowskyRainbowToken and _G.__GlazierAmbSkyMode ~= "Off" do
local atm=SkyLighting:FindFirstChild("GlazierAmbAtmosphere")
if not atm then break end
local h=(os.clock()%34)/34
pcall(function()
atm.Color=Color3.fromHSV(h,0.75,1)
atm.Decay=Color3.fromHSV((h+0.55)%1,0.8,1)
end)
SkyRunService.Heartbeat:Wait()
end
end)
end
if preset.drift or preset.flash or preset.pulse then
task.spawn(function()
local clk=_G.__GlazierAmbSkyClock or preset.clock or 14
local nextFlash=os.clock()+2
local baseB=preset.brightness or 2
local flashPart, flashLight
if preset.flash then
flashPart=Instance.new("Part")
flashPart.Name="GlazierAmbSkyFlash"; flashPart.Anchored=true; flashPart.CanCollide=false
flashPart.CanQuery=false; flashPart.CanTouch=false; flashPart.CastShadow=false
flashPart.Transparency=1; flashPart.Size=Vector3.new(1,1,1); flashPart.Parent=workspace
flashLight=Instance.new("PointLight"); flashLight.Range=60; flashLight.Brightness=0
flashLight.Shadows=false; flashLight.Enabled=false; flashLight.Color=Color3.fromRGB(205,220,255)
flashLight.Parent=flashPart
end
while dynskyDynToken and _G.__GlazierAmbSkyMode ~= "Off" do
local dt=SkyRunService.Heartbeat:Wait()
if preset.drift then
clk=(clk+(preset.drift or 0)*dt)%24
_G.__GlazierAmbSkyClock=clk; SkyLighting.ClockTime=clk
end
if preset.pulse then
local p=preset.pulse
local w=(math.sin(os.clock()math.pi2/(p.period or 4))+1)*0.5
SkyLighting.Brightness=(p.min or baseB)+(p.max-(p.min or baseB))w
end
if preset.flash and os.clock()>=nextFlash then
nextFlash=os.clock()+(preset.flash.gapMin or 2)+math.random()((preset.flash.gapMax or 6)-(preset.flash.gapMin or 2))
local cam=workspace.CurrentCamera
if flashPart and cam then
local ang=math.random()math.pi2; local dist=28+math.random()*26
flashPart.Position=cam.CFrame.Position+Vector3.new(math.cos(ang)*dist,16+math.random()*16,math.sin(ang)*dist)
end
task.spawn(function()
for _=1,(preset.flash.bursts or 2) do
if dyn~=skyDynToken then return end
if flashLight then flashLight.Brightness=14; flashLight.Enabled=true end
SkyLighting.Brightness=preset.flash.peak or 6
task.wait(0.05)
if flashLight then flashLight.Enabled=false end
SkyLighting.Brightness=baseB
task.wait(0.07)
end
end)
end
end
if flashPart then pcall(function() flashPart:Destroy() end) end
end)
end
end

function applyAmbitiousSky(mode)
mode=tostring(mode or "Off")
if not SKY_PRESETS[mode] then mode="Off" end
_G.__GlazierAmbSkyMode=mode
local idx=1
for i,n in ipairs(SKY_PRESETS_LIST) do if nmode then idx=i break end end
_G.__GlazierAmbSkyIndex=idx
_G.__CrystalSkyChangerMode=mode
clearSkyConnections()
clearCustomSky()
if mode"Off" then
skyDynToken += 1; skyRainbowToken += 1
restoreOriginalSky()
return
end
captureOriginalSky()
for _, obj in ipairs(SkyLighting:GetChildren()) do
if obj:IsA("Sky") or obj:IsA("Atmosphere") then pcall(function() obj:Destroy() end) end
end
local terrain=workspace:FindFirstChildOfClass("Terrain")
if terrain then
for _, obj in ipairs(terrain:GetChildren()) do
if obj:IsA("Clouds") then pcall(function() obj:Destroy() end) end
end
end
local p=SKY_PRESETS[mode]
SkyLighting.ClockTime=p.clock or 14; SkyLighting.Brightness=p.brightness or 2
if p.ambient then SkyLighting.Ambient=skyColor(p.ambient) end
if p.outAmb then SkyLighting.OutdoorAmbient=skyColor(p.outAmb) end
SkyLighting.FogStart=p.fog and p.fog[1] or 0
SkyLighting.FogEnd=p.fog and p.fog[2] or 100000
SkyLighting.FogColor=p.fog and skyColor(p.fog[3]) or Color3.fromRGB(200,200,200)
SkyLighting.GlobalShadows=p.shadows ~= false
SkyLighting.ExposureCompensation=p.exposure or 0
SkyLighting.ColorShift_Top=p.shiftTop and skyColor(p.shiftTop) or Color3.new(0,0,0)
SkyLighting.ColorShift_Bottom=p.shiftBot and skyColor(p.shiftBot) or Color3.new(0,0,0)
SkyLighting.GeographicLatitude=p.lat or 41.733
SkyLighting.EnvironmentDiffuseScale=p.envD or 1
SkyLighting.EnvironmentSpecularScale=p.envS or 1
_G.__GlazierAmbSkyClock=p.clock or 14
applySkyObjects(p)
startSkyDynamics(p)
local function guard(prop)
return SkyLighting:GetPropertyChangedSignal(prop):Connect(function()
if _G.__GlazierAmbSkyMode~=mode then return end
if prop=="ClockTime" and p.drift then return end
if prop=="Brightness" and (p.pulse or p.flash) then return end
local want=(prop=="ClockTime" and (p.clock or 14))
or (prop=="Brightness" and (p.brightness or 2))
or (prop=="Ambient" and p.ambient and skyColor(p.ambient))
or (prop=="OutdoorAmbient" and p.outAmb and skyColor(p.outAmb))
if want~=nil then pcall(function() SkyLighting[prop]=want end) end
end)
end
for _, prop in ipairs({"ClockTime","Brightness","Ambient","OutdoorAmbient"}) do
table.insert(skyConnections,guard(prop))
end
local function foreign(obj)
if _G.__GlazierAmbSkyMode~=mode then return end
if obj:GetAttribute("_GlazierAmbSky") then return end
if obj:IsA("Sky") or obj:IsA("Atmosphere") or obj:IsA("Clouds") then
pcall(function() obj:Destroy() end)
task.defer(function()
if _G.__GlazierAmbSkyMode==mode then applySkyObjects(p) end
end)
end
end
table.insert(skyConnections,SkyLighting.DescendantAdded:Connect(foreign))
if terrain then table.insert(skyConnections,terrain.DescendantAdded:Connect(foreign)) end
end

