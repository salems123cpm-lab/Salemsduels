obj.BackgroundColor3 = dimAccent
else
obj.BackgroundColor3 = dark
end
end
end
end

-- El botón mini también usa la paleta activa.
if miniButton and miniButton.Parent then
miniButton.BackgroundColor3 = dark
local ms = miniButton:FindFirstChildOfClass("UIStroke")
if ms then ms.Color = accent end
end
end

