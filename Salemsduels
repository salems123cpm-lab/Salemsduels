if trackedEnemy and ewTimerAcc >= 0.20 then
updateEnemyTimer(ewTimerAcc)
ewTimerAcc = 0
elseif not trackedEnemy and ewTimerAcc >= 0.20 then
ewTimerAcc = 0
end

local now = os.clock()
if now - ewLastScan < 0.25 then return end
ewLastScan = now

