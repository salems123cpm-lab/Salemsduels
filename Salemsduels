pa.Name="GlazierSkinPants"; pa:SetAttribute("GlazierSkinClothing",true)
pa.PantsTemplate=skin.pants; pa.Parent=character; table.insert(localSkinObjects,pa)
end
end

local function addAccessoryFromAsset(character, assetId, name)
local humanoid=character:FindFirstChildOfClass("Humanoid")
if not humanoid then return false end
local objects=loadSkinAsset(assetId)
if not objects then return false end
local added=false
for _,obj in ipairs(objects) do
local acc=obj:IsA("Accessory") and obj or obj:FindFirstChildWhichIsA("Accessory",true)
if acc then
local clone=acc:Clone()
clone.Name=name or "GlazierSkinAccessory"
clone:SetAttribute("GlazierSkinLocal",true)
local ok=pcall(function() humanoid:AddAccessory(clone) end)
if ok then table.insert(localSkinObjects,clone); added=true else pcall(function() clone:Destroy() end) end
end
pcall(function() obj:Destroy() end)
end
return added
end

local function applyHead(character, skin)
if not skin.headMesh then return end
local head=character:FindFirstChild("Head")
if not head then return end
pcall(function()
local sm=head:FindFirstChild("GlazierSkinHeadMesh") or Instance.new("SpecialMesh")
sm.Name="GlazierSkinHeadMesh"; sm.MeshType=Enum.MeshType.FileMesh
sm.MeshId=skin.headMesh; sm.TextureId=skin.headTexture or ""; sm.Parent=head
table.insert(localSkinObjects,sm)
end)
end

local function applyHeadlessLocal(character)
local head=character and character:FindFirstChild("Head")
if not head or not head:IsA("BasePart") then return end
if not originalHeadVisibility then
originalHeadVisibility={localTransparency=head.LocalTransparencyModifier,faces={}}
for _,obj in ipairs(head:GetDescendants()) do
if obj:IsA("Decal") or obj:IsA("Texture") then
table.insert(originalHeadVisibility.faces,{object=obj,transparency=obj.Transparency})
end
end
end
head.LocalTransparencyModifier=1
for _,obj in ipairs(head:GetDescendants()) do
if obj:IsA("Decal") or obj:IsA("Texture") then obj.Transparency=1 end
end
end

local function applyKorblox(character, side)
if side=="none" then return end
local ids={left=139607673,right=139607718}
local id=ids[tostring(side):lower()]
if not id then return end
addAccessoryFromAsset(character,id,"GlazierSkinKorblox")
end

local function applyDuelSkin(enabled)
local character=Player and Player.Character
local humanoid=character and character:FindFirstChildOfClass("Humanoid")
if not character or not humanoid then return false end
if not enabled then
clearLocalSkin()
if originalDescription and character==originalCharacter then
local clone=originalDescription:Clone()
pcall(function()
if humanoid.ApplyDescriptionReset then humanoid:ApplyDescriptionReset(clone)
else humanoid:ApplyDescription(clone) end
end)
pcall(function() clone:Destroy() end)
end
return true
end
if skinBusy then return false end
skinBusy=true
if originalCharacter~=character then
originalHeadVisibility=nil
local ok,desc=pcall(function() return humanoid:GetAppliedDescription() end)
if ok and desc then originalDescription=desc:Clone(); pcall(function() desc:Destroy() end) end
originalCharacter=character
end
clearLocalSkin()
local skin=duelSkins[skinSelection]
setClassicClothing(character,skin)
if skin.accessories then
for ,assetId in ipairs(skin.accessories) do addAccessoryFromAsset(character,assetId,"GlazierSkinAccessory"..tostring(assetId)) end
elseif skin.accessory then
addAccessoryFromAsset(character,skin.accessory,"GlazierSkinAccessory")
end
if skin.shirtAccessory then addAccessoryFromAsset(character,skin.shirtAccessory,"GlazierSkinShirtAccessory") end
if skin.headMesh then applyHead(character,skin) end
if skin.headless then applyHeadlessLocal(character) end
applyKorblox(character,skin.korblox)
skinBusy=false
return true
end

